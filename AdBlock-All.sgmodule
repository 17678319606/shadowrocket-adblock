#!name=广告过滤全家桶（Jinx+Johnshall+hdys专项）
#!desc=统一订阅版 v2026.11.08.7：Jinx基线 + Johnshall仅去广告(已启用, jsDelivr转换清单) + anti-AD + blackmatrix7 + hdys03专项（含响应体净化脚本：删内联混淆广告脚本、隐藏推广块与底部悬浮条，需HTTPS解密+信任本机CA）。域名规则不需要证书即可生效。放行在前拦截在后，顺序勿改。
#!author=Muse (maintained for 李雪含)
#!date=2026-11-08 23:08:42

[Rule]
# ===== A. 放行名单（必须最前，删了会误伤微信登录/推送等功能域）=====
# hdys 家族封代理/机房出口 IP、住宅直连可达，故强制直连（2026-11-08 实证：开小火箭经节点打不开、关掉直连正常）；HTTPS 解密与净化脚本不依赖代理路由，直连下照常生效
DOMAIN-SUFFIX,hdys03.com,DIRECT
DOMAIN-SUFFIX,hdfby.com,DIRECT
RULE-SET,https://raw.githubusercontent.com/RiverFlowsInUUU/RFU-Rules/main/surge-direct.list,DIRECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Direct/Direct.list,DIRECT
# ===== B. Jinx 基线（VME98/jinx-rules 3.2.3，经 RFU 转小火箭格式，8550 条）=====
RULE-SET,https://raw.githubusercontent.com/RiverFlowsInUUU/RFU-Rules/main/surge-ads.list,REJECT
# ===== C. Johnshall 仅去广告（sr_ad_only，每日8点重建：EasyList+EasyListChina+Peter Lowe+乘风+手工iOS广告；已转标准 RULE-SET 清单，53919 条，2026-11-08 转换）=====
RULE-SET,https://cdn.jsdelivr.net/gh/17678319606/shadowrocket-adblock@main/johnshall-ad.list,REJECT
# ===== D. blackmatrix7 广告集（Johnshall 懒人配置同源）=====
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/AdvertisingLite/AdvertisingLite.list,REJECT
DOMAIN-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Advertising/Advertising_Domain.list,REJECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Advertising/Advertising.list,REJECT
# ===== E. anti-AD 中文广告过滤（域名集）=====
DOMAIN-SET,https://anti-ad.net/surge2.txt,REJECT
# ===== F. hdys03 实测广告落地（2026-11-08 实查，博彩横幅，域名会轮换）=====
DOMAIN,jf3hax530-987855804.ap-northeast-2.elb.amazonaws.com,REJECT
DOMAIN,k8v3q6md-459895685.ap-northeast-2.elb.amazonaws.com,REJECT
# hdys03 页内统计/注入源（2026-11-08 源码实查：Yandex 统计与爱站统计加载器）
DOMAIN-SUFFIX,mc.yandex.ru,REJECT
DOMAIN-SUFFIX,aizhantj.com,REJECT

[URL Rewrite]
# 注：https 的 Rewrite 需要开启 HTTPS 解密并信任本机自生成 CA；没开也不影响上面域名规则
# hdys 广告落地形态：随机串-数字.ap-northeast-2.elb.amazonaws.com，换名也拦
^https?://[a-z0-9]+-\d+\.ap-northeast-2\.elb\.amazonaws\.com - reject
# MacCMS 影视站常见同域弹窗/广告路径
^https?://[^/]*\.hdys\d*\.com/.*(popunder|popup|/ads?/|/gg/|guanggao) - reject
^https?://[^/]*\.hdys\d*\.com/static/js/ad.* - reject

[Script]
# hdys 响应体净化（需 HTTPS 解密已开+CA 已信任）：删内联混淆广告脚本、隐藏 sponsor-block 与底部悬浮条
hdys-clean = type=http-response, pattern=^https?://[^/]*\.hdys03\.com/, script-path=https://cdn.jsdelivr.net/gh/17678319606/shadowrocket-adblock@main/hdys-clean.js, requires-body=true, max-size=4194304

[MITM]
hostname = %APPEND% *.hdys03.com, 7rkj.hdys03.com
